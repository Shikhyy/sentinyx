# Copy to .env and fill in locally. Never commit .env or paste these values into a chat.
BASE_RPC_URL=https://mainnet.base.org
ETH_RPC_URL=https://cloudflare-eth.com
# Optional: enables the language-model second opinion
ANTHROPIC_API_KEY=
SENTINYX_MODEL=claude-haiku-5-5
IPFS_GATEWAY=https://ipfs.io/ipfs/
BLOCKSCOUT_API=https://base.blockscout.com/api/v2
# Base Sepolia (for demo contracts). Optional; public defaults are used if empty.
BASE_SEPOLIA_RPC_URL=
BLOCKSCOUT_SEPOLIA_API=https://base-sepolia.blockscout.com/api/v2

# Web app
# Postgres connection string (Neon or Supabase). Empty = in-memory store, fine for local dev, lost on restart.
DATABASE_URL=
# Scans per minute per IP on POST /api/scan
SCAN_RATE_LIMIT=10
# Canonical site URL for share cards, e.g. https://your-app.vercel.app
NEXT_PUBLIC_SITE_URL=
# Night Ledger: Vercel Cron sends this as `Authorization: Bearer <value>` to /api/cron/crawl. Without it the route refuses to run.
CRON_SECRET=
# Guard traces: POST /api/traces accepts JSON lines from `sentinyx` only with this as `Authorization: Bearer <value>`. Empty = endpoint refuses.
TRACE_INGEST_TOKEN=
# After deploying the demo coin to Base Sepolia: its address, to add a one-click "Night Pepe (demo)" example on the scan box.
NEXT_PUBLIC_DEMO_COIN=

# Demo coin deploy (contracts/): read from your shell only. Use a THROWAWAY testnet key, never a real one. Leave empty here.
DEPLOYER_PRIVATE_KEY=
DEMO_ATTACKER_ADDRESS=
